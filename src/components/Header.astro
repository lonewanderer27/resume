---
import type { Contact } from "../types";

const { supportDarkMode, title, contact } = Astro.props as { supportDarkMode: boolean, title: string, contact?: Contact };
import { MoonIcon, DownloadIcon } from "astro-feather";

const contactParts = [
  contact?.address && { text: contact.address },
  contact?.email && { text: contact.email, href: `mailto:${contact.email}` },
  contact?.phone && { text: contact.phone, href: `tel:${contact.phone}` },
  contact?.github && { text: `github.com/${contact.github}`, href: `https://github.com/${contact.github}` },
  contact?.linkedin && { text: `linkedin.com/in/${contact.linkedin}`, href: `https://linkedin.com/in/${contact.linkedin}` },
].filter(Boolean) as { text: string, href?: string }[];
---

<div class="header">
  <h1 class="title">{title}</h1>
  {contactParts.length > 0 && (
    <p class="contact-line">
      {contactParts.map((part, i) => (
        <>
          {i > 0 && " • "}
          {part.href ? <a href={part.href}>{part.text}</a> : part.text}
        </>
      ))}
    </p>
  )}
  <div class="header--buttons">
    <a
      id="download"
      title="Download PDF version of this resume"
      href="https://github.com/lonewanderer27/resume/releases/latest/download/Ian_James_Resume_GA.pdf">
      <DownloadIcon stroke="var(--fg-color)" />
    </a>
    {supportDarkMode && (
      <input type="checkbox" id="switch" name="mode" class="toggle-dark"></input>
      <label for="switch" title="Toggle Dark Mode">
        <div id="moon">
          <MoonIcon stroke="var(--fg-color)" />
        </div>
      </label>
    )}
  </div>
</div>

<script lang="js">
const checkbox = document.getElementById("switch")
function toggleTheme() {
  if (checkbox.checked) {
    console.log('checked')
    document.documentElement.setAttribute('data-theme', 'dark')
    var moon = document.getElementById('moon')
    moon.innerHTML = feather.icons['sun'].toSvg({'fill': 'var(--fg-color-dark)'})
  } else {
    console.log('unchecked')
    document.documentElement.setAttribute('data-theme', 'light')
    var moon = document.getElementById('moon')
    moon.innerHTML = feather.icons['moon'].toSvg({'fill': 'var(--fg-color-dark)'})
  }
}
checkbox.addEventListener('change', () => {
  // Fallback for browsers that dont support view transitions
  if (!document.startViewTransition) {
    toggleTheme();
    return;
  }

  document.startViewTransition(() => toggleTheme())
})
</script>

<style lang="scss">
.header {
    width: 90%;
    margin: 0 auto;
    position: relative;
    text-align: center;
    .title {
        color: var(--fg-color-dark);
        font-weight: bolder;
        text-transform: uppercase;
        margin-bottom: 4px;
    }
    .contact-line {
        @include body-text;
        margin: 0;
        a {
            color: var(--fg-color-body);
            text-decoration: none;
            &:hover {
                text-decoration: underline;
            }
        }
    }
    .header--buttons {
      position: absolute;
      top: 0;
      right: 0;
      display: flex;
      #download {
        margin-right: 10px;
      }
    }
    input[type="checkbox"] {
        width: 0;
        height:0;
        display: none;
        margin-left: 5px
    }
    label {
        cursor: pointer;
        color: var(--fg-color-dark);

    }
}
</style>