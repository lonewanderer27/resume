---
import type { Certificate } from "../types"; // Assuming Certificate type is defined elsewhere

const { certificates } = Astro.props as { certificates: Certificate[] };
---

{certificates && certificates.length > 0 && (
  <section class="certificates">
    <div class="title">Certificates</div>
    {certificates.map(c => (
      <div class="certificate-item">
        <a href={c.link} class="title">{c.title}</a>, {c.issuer} — {c.date}
      </div>
    ))}
  </section>
)}

<style lang="scss">
.certificates {
    > .title {
        @include header;
    }
    .certificate-item {
        @include body-text;
        margin-top: 0;
        .title {
            font-weight: bold;
            color: var(--fg-color-body);
            text-decoration: none;
            &:hover {
                text-decoration: underline;
            }
        }
    }
}
</style>
