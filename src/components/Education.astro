---
import type { Education } from "../types";

const { education } = Astro.props as { education: Education[] };
---

{education && (
  <section class="education">
    <div class="title">Education</div>
    
    {education.map((ed) => (
      <div class="education-item">
        <span class="degree">{ed.degree}</span>, {ed.institute}{ed.date && <> — {ed.date}</>}
      </div>
    ))}
  </section>
)}

<style lang="scss">
.education {
    .title {
        @include header;
    }
    .education-item {
        @include body-text;
        margin-top: 0;
        .degree {
            font-weight: bold;
        }
    }
}
</style>
