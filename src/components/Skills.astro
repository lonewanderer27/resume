---
import type { Skill } from "../types";

const { skills } = Astro.props as { skills: Skill[] };
---

{skills && (
  <section class="skills">
    <div class="title">Skills</div>
    {skills.map((sks) => (
      <div class="skill-row">
        <span class="category">{sks.category}:</span>
        <span class="skill-list">{sks.skills.join(", ")}</span>
      </div>
    ))}
  </section>
)}

<style lang="scss">
.skills {
    .title {
        @include header;
    }
    .skill-row {
        @include body-text;
        margin-top: 0;
        .category {
            font-weight: bold;
            color: var(--fg-color);
        }
        .skill-list {
            margin-left: 4px;
        }
    }
}
</style>
